heart = [
"           *****     *****",
"        ********* *********",
"      *********************",
"     ***********************",
"     ***********************",
"      *********************",
"        *****************",
"          *************",
"            *********",
"              *****",
"                *"
]

name = "Siddhi"
idx = 0

for row in heart:
    line = ""
    for ch in row:
        if ch == "*":
            line += name[idx % len(name)]
            idx += 1
        else:
            line += " "
    print(line)
